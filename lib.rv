// raven-dotenv: parse .env files into a typed config for Raven.
//
//     import "github.com/martian56/raven-dotenv" { load }
//
//     fun main() {
//         match load(".env") {
//             Ok(cfg) -> {
//                 let port = cfg.get_int_or("PORT", 8080)
//                 let url = cfg.get_or("DATABASE_URL", "sqlite://local.db")
//             },
//             Err(e) -> print(e.to_string()),
//         }
//     }
//
// Supported syntax: `KEY=value`, `export KEY=value`, `#` comments (whole-line
// and inline after whitespace), blank lines, double quotes with `\n`/`\t`/`\r`
// escapes, and single quotes that take the value literally.

import std/string
import std/collections
import std/fs { read }

// A syntax error in a .env source, carrying the 1-based line it was found on.
struct ParseError {
    line: Int,
    message: String,
}

impl ParseError {
    fun new(line: Int, message: String) -> ParseError {
        return ParseError { line, message }
    }
}

impl ToString for ParseError {
    fun to_string(self) -> String {
        return ".env:${self.line}: ${self.message}"
    }
}

// A parsed environment: a set of string keys and values, with typed accessors.
struct Config {
    values: Map<String, String>,
}

impl Config {
    // An empty config, handy as a base for layering defaults under a file.
    fun new() -> Config {
        return Config { values: Map.new() }
    }

    // The raw value for `key`, if present.
    fun get(self, key: String) -> Option<String> {
        return self.values.get(key)
    }

    // The value for `key`, or `fallback` when it is absent.
    fun get_or(self, key: String, fallback: String) -> String {
        return self.values.get_or(key, fallback)
    }

    // The value for `key`, or an error naming the missing key.
    fun require(self, key: String) -> Result<String, String> {
        return match self.values.get(key) {
            Some(v) -> Ok(v),
            None -> Err("missing required key: ".concat(key)),
        }
    }

    // The value parsed as an `Int`, if present and numeric.
    fun get_int(self, key: String) -> Option<Int> {
        return match self.values.get(key) {
            Some(v) -> v.parse_int(),
            None -> None,
        }
    }

    // The value as an `Int`, or `fallback` when it is absent or not numeric.
    fun get_int_or(self, key: String, fallback: Int) -> Int {
        return match self.values.get(key) {
            Some(v) -> match v.parse_int() {
                Some(n) -> n,
                None -> fallback,
            },
            None -> fallback,
        }
    }

    // The value read as a `Bool`: true for `true`, `1`, `yes`, or `on`
    // (case-insensitive); false for any other present value; `None` when absent.
    fun get_bool(self, key: String) -> Option<Bool> {
        return match self.values.get(key) {
            Some(v) -> Some(_is_truthy(v)),
            None -> None,
        }
    }

    // The value read as a `Bool`, or `fallback` when it is absent.
    fun get_bool_or(self, key: String, fallback: Bool) -> Bool {
        return match self.values.get(key) {
            Some(v) -> _is_truthy(v),
            None -> fallback,
        }
    }

    // Whether `key` is set.
    fun has(self, key: String) -> Bool {
        return self.values.has(key)
    }

    // Every key, in no particular order.
    fun keys(self) -> List<String> {
        return self.values.keys()
    }

    // The number of keys.
    fun len(self) -> Int {
        return self.values.len()
    }

    // Insert or overwrite a value. Set defaults before `load` overlays a file,
    // or override after.
    fun set(self, key: String, value: String) {
        self.values.set(key, value)
    }
}

// Parse a .env document into a `Config`.
fun parse(text: String) -> Result<Config, ParseError> {
    let config = Config.new()
    let rows = text.lines()
    let i = 0
    while i < rows.len() {
        let _applied = _apply_line(config, rows[i], i + 1)?
        i += 1
    }
    return Ok(config)
}

// Read the file at `path` and parse it.
fun load(path: String) -> Result<Config, ParseError> {
    return match read(path) {
        Ok(text) -> parse(text),
        Err(e) -> Err(ParseError.new(0, "cannot read ${path}")),
    }
}

// Parse one line into `config`. Returns Ok(true) when a key/value was set,
// Ok(false) for a blank line or comment, and Err for a syntax error.
fun _apply_line(config: Config, raw: String, lineno: Int) -> Result<Bool, ParseError> {
    let line = raw.trim()
    if line.is_empty() {
        return Ok(false)
    }
    if line.starts_with("#") {
        return Ok(false)
    }
    let body = line
    if body.starts_with("export ") {
        body = body.substring(7, body.length()).trim_start()
    }
    let eq = body.index_of("=")
    if eq < 0 {
        return Err(ParseError.new(lineno, "expected KEY=VALUE"))
    }
    let key = body.substring(0, eq).trim()
    if key.is_empty() {
        return Err(ParseError.new(lineno, "empty key"))
    }
    let rest = body.substring(eq + 1, body.length()).trim_start()
    let value = _parse_value(rest, lineno)?
    config.set(key, value)
    return Ok(true)
}

// Parse the value part of a line: a double- or single-quoted string, or a bare
// value (trailing inline `#` comment and surrounding whitespace removed).
fun _parse_value(rest: String, lineno: Int) -> Result<String, ParseError> {
    if rest.is_empty() {
        return Ok("")
    }
    let first = rest.char_at(0)
    if first == "\"" {
        return _parse_quoted(rest, lineno, "\"", true)
    }
    if first == "'" {
        return _parse_quoted(rest, lineno, "'", false)
    }
    let comment = rest.index_of(" #")
    let bare = rest
    if comment >= 0 {
        bare = rest.substring(0, comment)
    }
    return Ok(bare.trim_end())
}

// Read a quoted value. `quote` is the delimiter; when `escapes` is true a
// backslash escapes the next character (double quotes), otherwise the contents
// are literal (single quotes).
fun _parse_quoted(rest: String, lineno: Int, quote: String, escapes: Bool) -> Result<String, ParseError> {
    let n = rest.length()
    let i = 1
    let out = ""
    while i < n {
        let c = rest.char_at(i)
        if c == quote {
            return Ok(out)
        }
        if escapes && c == "\\" && i + 1 < n {
            out = out.concat(_unescape(rest.char_at(i + 1)))
            i += 2
        } else {
            out = out.concat(c)
            i += 1
        }
    }
    return Err(ParseError.new(lineno, "unterminated quoted value"))
}

// Map a character following a backslash to its escaped form. An unknown escape
// keeps the backslash and the character.
fun _unescape(c: String) -> String {
    if c == "n" {
        return "\n"
    }
    if c == "t" {
        return "\t"
    }
    if c == "r" {
        return "\r"
    }
    if c == "\"" {
        return "\""
    }
    if c == "'" {
        return "'"
    }
    if c == "\\" {
        return "\\"
    }
    return "\\".concat(c)
}

fun _is_truthy(v: String) -> Bool {
    let s = v.to_lower()
    return s == "true" || s == "1" || s == "yes" || s == "on"
}
